<!DOCTYPE html>
<html>
<head>
    <title>Blog</title>
</head>
<body>

    <h1>All Blog Posts</h1>

    <a href="/blog/new">Create New Post</a>
    <hr>

    <% posts.forEach(function(post) { %>
        <h3>
            <a href="/blog/<%= post.id %>">
                <%= post.title %>
            </a>
        </h3>
    <% }); %>

</body>
</html>
