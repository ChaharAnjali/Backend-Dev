<h2>Cart</h2>

<% if (user) { %>
    <p>Logged in as: <%= user.username %></p>
<% } else { %>
    <p>Guest User</p>
<% } %>

<ul>
    <% cart.forEach(item => { %>
        <li><%= item %></li>
    <% }) %>
</ul>

<hr>

<h3>Add Item</h3>
<form action="/add-to-cart" method="POST">
    <input type="text" name="item" placeholder="Item name" required />
    <button type="submit">Add</button>
</form>

<br>

<% if (user) { %>
    <a href="/logout">Logout</a>
<% } else { %>
    <a href="/">Go to Login</a>
<% } %>